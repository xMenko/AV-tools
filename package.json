{
  "name": "av-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-Rechner und Messwerkzeuge für die Veranstaltungstechnik (PWA)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode https",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify": "npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tsconfig/svelte": "5.0.8",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  }
}
